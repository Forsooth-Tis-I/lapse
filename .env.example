# Copy to .env and fill in. .env is gitignored. Never paste these values into chat.

# LLM: any OpenAI-compatible endpoint. Default: OpenCode Go (requires an x-opencode-session header, sent automatically).
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=kimi-k2.7-code

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# FalkorDB (docker compose maps 6380 on localhost; 6379 is taken)
FALKORDB_HOST=localhost
FALKORDB_PORT=6380

# Inboxes the agent reads (IMAP + app password). Gmail: imap.gmail.com
PRIMARY_IMAP_HOST=imap.gmail.com
PRIMARY_IMAP_USER=
PRIMARY_IMAP_PASSWORD=
COLLEGE_IMAP_HOST=imap.gmail.com
COLLEGE_IMAP_USER=
COLLEGE_IMAP_PASSWORD=

# Local secrets. Generate both with: make keys
LAPSE_SECRET_KEY=
APPROVAL_SIGNING_KEY=

# Which user graph the single-user demo runs as
LAPSE_UID=demo
# docker compose links the first Telegram chat to LAPSE_UID automatically (set false to require a link code)
# BOT_ALLOW_DEFAULT_UID=true
# Public read-only demo mode for the web app (true/false)
LAPSE_DEMO_MODE=false

# Seconds the LLM gets to pick tools before the deterministic router answers (default 7)
AGENT_LLM_BUDGET_SECONDS=15
